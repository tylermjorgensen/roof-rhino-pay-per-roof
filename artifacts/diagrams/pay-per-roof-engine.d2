  style.stroke: "#DC8A18"
  style.font-color: "#6E3A00"
  style.font-size: 13
  style.border-radius: 8
}

buyerproof -> not_fit: "invalid"
closeloop -> nurture: "not ready"
closeloop -> lost: "lost"
rooflock -> covered_failure: "criteria fail"

controls: "SYSTEM CONTROLS\n\nPARTNER STATUS\nLicensing • insurance • inspection capacity\ntimely estimates • follow-up • accurate data\nprofessional fulfillment\n\nFIRST ROOF GUARANTEE™\nIf no Verified Won Roof by day 45 and\nrequirements were maintained: continue at no\nadded performance cost OR return unearned credits\n\nFEEDBACK LOOP\nAttribution, dispositions, show rate, close rate,\nand economics improve the next cycle" {
  style.fill: "#07172B"
  style.stroke: "#496A90"
  style.stroke-width: 2
  style.font-color: "#FFFFFF"
  style.font-size: 14
  style.border-radius: 12
}

roofmap -> controls: "activate controls" {
  style.stroke-dash: 6
  style.stroke: "#6B829F"
  style.font-color: "#53647A"
}

rooflock -> controls: "measure + improve" {
  style.stroke-dash: 6
  style.stroke: "#6B829F"
  style.font-color: "#53647A"
}

fee_rule: |md
  **THE ONLY FEE TRIGGER**  →  A qualifying signed roofing customer that passes every RoofLock™ condition.
| {
  near: bottom-center
  shape: text
  style.font-size: 17
  style.bold: true
  style.font-color: "#0054D8"
}

legend: |md
  **COLOR KEY**  Blue = Roof Rhino  •  Navy = Roofing Partner / shared verification  •  Cyan = shared conversion  •  Green = verified outcome
| {
  near: bottom-left
  shape: text
  style.font-size: 13
  style.font-color: "#53647A"
}
